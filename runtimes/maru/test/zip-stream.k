;; Zip streams (R-zip-stream): DupZip(PassThrough, PassThrough) fed in two pieces of 1000 floats, the first poured and
;; run to rest before the second is poured. Its output must already hold pairs after the first piece (the zippers
;; hand on each full buffer as both have filled it, as C's nile_Zip_body does, rather than waiting for the end), and
;; the whole must come out as pairs (k/2 at each position k). argv[1] is the worker count, one by default.
;; Prints "zip stream ok"; check nile_zip_stream compares the line.

(define (printf (int char * ...) *) (extern printf))
(define (malloc (void * long) *) (extern malloc))
(define (free (void void *) *) (extern free))
(define (atoi (int char *) *) (extern atoi))

(define (NPIECE int) 1000)
(define (NBYTES_PER_THREAD int) 1000000)

(define-function build_zip (nile_Process_t *)
  ((init nile_Process_t *) (out float *) (count int *))
  (let (((p nile_Process_t *) (nile_Capture init out count (* 4 NPIECE))))
    (set p (nile_Process_pipe (nile_DupZip init 1 (nile_PassThrough init 1) 1 (nile_PassThrough init 1) 1) p))
    (return (nile_Process_pipe (nile_Funnel init) p))))

(define-function pour_piece void ((data float *) (first int))
  (let ((k 0))
    (while (< k NPIECE)
      (set (indir data k) (cast (+ (* first NPIECE) k) float))
      (set k (+ k 1)))))

(define-function main int ((argc int) (argv char * *))
  (let* (((nthreads int) (if (> argc 1) (atoi (indir argv 1)) 1))
	 ((nbytes int) (* NBYTES_PER_THREAD nthreads))
	 ((mem char *) (malloc (cast nbytes long)))
	 ((init nile_Process_t *) (nile_startup mem nbytes nthreads))
	 ((data float *) (malloc (cast (* NPIECE 4) long)))
	 ((out float *) (malloc (cast (* (* 4 NPIECE) 4) long)))
	 ((count int) 0)
	 ((early int) 0)
	 ((failed int) 0)
	 (k 0))
    (if (= 0 (cast init long))
	(return 1))
    (let ((head (build_zip init out (addressof count))))
      (pour_piece data 0)
      (nile_Funnel_pour head data NPIECE 0)
      (nile_sync init)
      (set early count)
      (pour_piece data 1)
      (nile_Funnel_pour head data NPIECE 1)
      (nile_sync init))
    (if (or (nile_error init) (!= count (* 4 NPIECE)) (< early 2))
	(set failed 1))
    (while (and (= failed 0) (< k count))
      (if (!= (cast (indir out k) int) (/ k 2))
	  (set failed 1))
      (set k (+ k 1)))
    (if (= failed 0)
	(printf "zip stream ok\n")
	(printf "zip stream FAILED: %d before the second piece, %d in all\n" early count))
    (free (nile_shutdown init))
    (free data)
    (free out)
    (return failed)))
