;; gezira_oom: Gezira fills on a runtime with a tiny block quota, so the out-of-memory path runs: a fill that can't get a
;; block must report NILE_STATUS_OUT_OF_MEMORY (1) and stop, never write outside its buffers (ASan), and never stall.
;; argv[1] is the worker count, one by default; the quota is OOM_BYTES per worker. Prints "gezira oom ok" when the fills
;; that ran return 0 or 1, at least one returns 1, and the runtime shuts down; check gezira_oom compares the line,
;; an empty stderr, and a wall-clock limit (a stall fails the check).

(define (printf (int char * ...) *) (extern printf))
(define (malloc (void * long) *) (extern malloc))
(define (free (void void *) *) (extern free))
(define (atoi (int char *) *) (extern atoi))

(define (WIDTH int) 1024)
(define (HEIGHT int) 768)
(define (OOM_BYTES int) 65536)
(define (NFILLS int) 6)
(define (NFILLS_MAX int) 40)

(define-function main int ((argc int) (argv char * *))
  (let* (((workers int) (if (> argc 1) (atoi (indir argv 1)) 1))
	 ((nbytes int) (* (if (> argc 2) (atoi (indir argv 2)) OOM_BYTES) workers))
	 ((mem char *) (malloc (cast nbytes long)))
	 ((init nile_Process_t *) (nile_startup mem nbytes workers))
	 ((pixels long) (gezira_image_new WIDTH HEIGHT))
	 ((params float *) (malloc (cast 40 long)))
	 ((data float *) (malloc (cast (* 24 4) long)))
	 ((other int) 0)
	 ((oom int) 0)
	 ((k int) 0)
	 ((status int) 0))
    (if (= 0 (cast init long))
	(return 1))
    (set (indir params 0) (cast 1.0 float)) (set (indir params 1) (cast 0.0 float))
    (set (indir params 2) (cast 0.0 float)) (set (indir params 3) (cast 1.0 float))
    (set (indir params 4) (cast 10.0 float)) (set (indir params 5) (cast 10.0 float))
    (set (indir params 6) (cast 1.0 float)) (set (indir params 7) (cast 1.0 float))
    (set (indir params 8) (cast 0.0 float)) (set (indir params 9) (cast 0.0 float))
    ;; a 540 by 620 rectangle, as KSWorld's first path is
    (let ()
      (set (indir data 0) (cast 0.0 float)) (set (indir data 1) (cast 0.0 float))
      (set (indir data 2) (cast 0.0 float)) (set (indir data 3) (cast 0.0 float))
      (set (indir data 4) (cast 540.0 float)) (set (indir data 5) (cast 0.0 float))
      (set (indir data 6) (cast 540.0 float)) (set (indir data 7) (cast 0.0 float))
      (set (indir data 8) (cast 540.0 float)) (set (indir data 9) (cast 0.0 float))
      (set (indir data 10) (cast 540.0 float)) (set (indir data 11) (cast 620.0 float))
      (set (indir data 12) (cast 540.0 float)) (set (indir data 13) (cast 620.0 float))
      (set (indir data 14) (cast 540.0 float)) (set (indir data 15) (cast 620.0 float))
      (set (indir data 16) (cast 0.0 float)) (set (indir data 17) (cast 620.0 float))
      (set (indir data 18) (cast 0.0 float)) (set (indir data 19) (cast 620.0 float))
      (set (indir data 20) (cast 0.0 float)) (set (indir data 21) (cast 620.0 float))
      (set (indir data 22) (cast 0.0 float)) (set (indir data 23) (cast 0.0 float)))
    (while (< k (if (> argc 3) (atoi (indir argv 3)) NFILLS))
      (set status (gezira_fill (cast init long) pixels WIDTH HEIGHT params data 24))
      (if (= status 1) (set oom (+ oom 1)))
      (if (and (!= status 0) (!= status 1)) (set other (+ other 1)))
      (set k (+ k 1)))
    (nile_print_leaks init)
    (gezira_image_free pixels)
    (free (nile_shutdown init))
    (free params)
    (free data)
    (if (and (= other 0) (> oom 0))
	(printf "gezira oom ok\n")
	(printf "gezira oom FAILED: %d other statuses, %d out of memory\n" other oom))
    (return 0)))
