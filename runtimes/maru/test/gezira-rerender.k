;; gezira_rerender: a KSWorld frame's fill calls, recorded from untyped Maru (check/ksworld-frame-dump.l) and
;; rendered again and again on one runtime. The file has, for each call, "F", the matrix (a b c d e f), the
;; paint (alpha red green blue), the float count and the floats. argv[1] is the worker count, argv[2] the number of
;; frames, argv[3] the file. Each frame clears the image to white and fills every call through gezira_fill, which
;; waits for its pipeline. Prints "gezira rerender ok" when every fill returns 0, nile_error stays clear and nile_print_leaks
;; finds nothing; check gezira_rerender compares the line and an empty stderr.

(define (printf (int char * ...) *) (extern printf))
(define (malloc (void * long) *) (extern malloc))
(define (free (void void *) *) (extern free))
(define (calloc (void * long long) *) (extern calloc))
(define (atoi (int char *) *) (extern atoi))
(define (fopen (void * char * char *) *) (extern fopen))
(define (fclose (int void *) *) (extern fclose))
(define (fscanf (int void * char * ...) *) (extern fscanf))

(define (WIDTH int) 1024)
(define (HEIGHT int) 768)
(define (MAXCALLS int) 1000)
(define (MAXFLOATS int) 400000)

;; Reads the frame's calls into hdr (ten floats a call), counts, offsets and floats; returns the number of calls, or -1.
(define-function read_frame int
  ((path char *) (hdr float *) (counts int *) (offsets int *) (floats float *))
  (let* (((f void *) (fopen path "r"))
	 ((cbuf char *) (malloc 4))
	 ((n int) 0)
	 ((pos int) 0)
	 ((ok int) 1)
	 (k 0))
    (if (= 0 (cast f long))
	(return -1))
    (while (and (= ok 1) (= 1 (fscanf f " %c" cbuf)) (= 70 (cast (indir cbuf 0) int)))
      (set k 0)
      (while (< k 10)
	(fscanf f " %f" (addressof (indir hdr (+ (* n 10) k))))
	(set k (+ k 1)))
      (fscanf f " %d" (addressof (indir counts n)))
      (set (indir offsets n) pos)
      (set k 0)
      (while (< k (indir counts n))
	(fscanf f " %f" (addressof (indir floats (+ pos k))))
	(set k (+ k 1)))
      (set pos (+ pos (indir counts n)))
      (set n (+ n 1))
      (if (or (>= n MAXCALLS) (>= pos MAXFLOATS))
	  (set ok 0)))
    (free cbuf)
    (fclose f)
    (return n)))

(define-function render_frame int
  ((init long) (pixels long) (hdr float *) (counts int *) (offsets int *) (floats float *) (calls int))
  (let* (((params float *) (malloc (cast 40 long)))
	 ((n int) 0)
	 ((status int) 0)
	 (k 0))
    (gezira_image_clear pixels WIDTH HEIGHT -1)
    (while (and (= status 0) (< n calls))
      (set k 0)
      (while (< k 10)
	(set (indir params k) (indir hdr (+ (* n 10) k)))
	(set k (+ k 1)))
      (set status (gezira_fill init pixels WIDTH HEIGHT params (addressof (indir floats (indir offsets n)))
			       (indir counts n)))
      (set n (+ n 1)))
    (free params)
    (return status)))

(define-function main int ((argc int) (argv char * *))
  (let* (((workers int) (if (> argc 1) (atoi (indir argv 1)) 1))
	 ((frames int) (if (> argc 2) (atoi (indir argv 2)) 2))
	 ((hdr float *) (malloc (cast (* (* MAXCALLS 10) 4) long)))
	 ((counts int *) (malloc (cast (* MAXCALLS 4) long)))
	 ((offsets int *) (malloc (cast (* MAXCALLS 4) long)))
	 ((floats float *) (malloc (cast (* MAXFLOATS 4) long)))
	 ((init long) (gezira_start workers))
	 ((pixels long) (gezira_image_new WIDTH HEIGHT))
	 ((calls int) (read_frame (indir argv 3) hdr counts offsets floats))
	 ((failed int) 0)
	 ((probe float *) (malloc (cast 40 long)))
	 ((image-params float *) (calloc 12 4))	; a path's matrix and a texture's, as gezira_fill_image reads them
	 (f 0))
    (if (= 0 init)
	(let () (printf "gezira rerender FAILED: no runtime\n") (return 1)))
    (if (<= calls 0)
	(let () (printf "gezira rerender FAILED: %d calls read from %s\n" calls (indir argv 3)) (return 1)))
    (while (and (= failed 0) (< f frames))
      (if (!= 0 (render_frame init pixels hdr counts offsets floats calls))
	  (set failed 1))
      (set f (+ f 1)))
    (if (= failed 0)	; a refused fill makes nothing, its paint included, so nile_print_leaks finds every block
	(if (!= 2 (gezira_fill init pixels WIDTH HEIGHT probe floats 8))
	    (let () (printf "gezira rerender: a partial element is not refused\n") (set failed 1))))
    (if (= failed 0)
	(if (!= 2 (gezira_fill_image init pixels WIDTH HEIGHT image-params floats 8 pixels WIDTH HEIGHT 1))
	    (let () (printf "gezira rerender: a partial element is not refused with an image\n") (set failed 1))))
    (nile_print_leaks (cast init nile_Process_t *))
    (gezira_stop init)
    (gezira_image_free pixels)
    (free probe)
    (free image-params)
    (free hdr)
    (free counts)
    (free offsets)
    (free floats)
    (if (= failed 0)
	(printf "gezira rerender ok\n")
	(printf "gezira rerender FAILED at frame %d\n" f))
    (return failed)))
