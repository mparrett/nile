;; Every call nile.k declares must be defined by the runtime. ir2 resolves each
;; extern with dlsym when main starts, so a call the runtime lacks is NULL here.
;; Build with nile.k and the runtime; the check expects every call found.

(define (printf (int char * ...) *) (extern printf))

(define-function main int ((argc int) (argv char * *))
  (let ((missing 0))
    (if (= 0 (cast nile_startup long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_shutdown long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_sync long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_status long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_error long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_print_leaks long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_pipe long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_feed long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_gate long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_pipeline long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_launch long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_memory long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_advance_output long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_advance_input long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_prefix_input long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_return long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Process_reroute long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_PassThrough long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Capture long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Reverse long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_SortBy long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_DupZip long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_DupCat long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Funnel long)) (set missing (+ missing 1)))
    (if (= 0 (cast nile_Funnel_pour long)) (set missing (+ missing 1)))
    (printf "nile interface: %d calls, %d missing\n" 26 missing)
    (return missing)))
