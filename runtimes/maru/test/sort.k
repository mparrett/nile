;; SortBy (R-sort). Quantum 2: 1,000 elements (a, b) from a fixed LCG, with a in 0 .. 9
;; and b in 0 .. 999. Field 1 is sorted first, then field 0, so the output must be
;; sorted on (field 0, field 1), and it must hold the same multiset of elements
;; (checked with a histogram over (a, b): nothing lost or duplicated).
;;
;; argv[1] is the worker count, one by default. Prints "sort ok"; check nile_sort
;; compares the line.

(define (printf (int char * ...) *) (extern printf))
(define (malloc (void * long) *) (extern malloc))
(define (free (void void *) *) (extern free))
(define (atoi (int char *) *) (extern atoi))

(define (NELEMS int) 1000)
(define (NBYTES_PER_THREAD int) 1000000)

(define-function build_sort (nile_Process_t *)
  ((init nile_Process_t *) (out float *) (count int *))
  (let ((p (nile_Capture init out count (* 2 NELEMS))))
    (set p (nile_Process_pipe (nile_SortBy init 2 0) p))
    (set p (nile_Process_pipe (nile_SortBy init 2 1) p))
    (return (nile_Process_pipe (nile_Funnel init) p))))

;; The elements are (a, b) pairs; the histogram index a * 1000 + b counts each pair.
(define-function pair_index int ((a int) (b int))
  (return (+ (* a 1000) b)))

(define-function run_sort int ((init nile_Process_t *))
  (let* (((data float *) (malloc (cast (* (* 2 NELEMS) 4) long)))
	 ((out float *) (malloc (cast (* (* 2 NELEMS) 4) long)))
	 ((hist int *) (malloc (cast (* 10000 4) long)))
	 ((count int) 0)
	 ((ok int) 1)
	 ((seed long) 17837643)
	 ((a int) 0)
	 ((b int) 0)
	 (k 0))
    (while (< k 10000)
      (set (indir hist k) 0)
      (set k (+ k 1)))
    (set k 0)
    (while (< k NELEMS)
      (set seed (% (* seed (cast 48271 long)) (cast 2147483647 long)))
      (set a (cast (% seed (cast 10 long)) int))
      (set seed (% (* seed (cast 48271 long)) (cast 2147483647 long)))
      (set b (cast (% seed (cast 1000 long)) int))
      (set (indir data (* 2 k)) (cast a float))
      (set (indir data (+ (* 2 k) 1)) (cast b float))
      (set (indir hist (pair_index a b)) (+ (indir hist (pair_index a b)) 1))
      (set k (+ k 1)))
    (nile_Funnel_pour (build_sort init out (addressof count)) data (* 2 NELEMS) 1)
    (nile_sync init)
    (if (or (nile_error init) (!= count (* 2 NELEMS)))
	(set ok 0))
    ;; sorted on (field 0, field 1): each element is at least its predecessor
    (set k 1)
    (while (and (= ok 1) (< k NELEMS))
      (let (((pa int) (cast (indir out (* 2 (- k 1))) int))
	    ((pb int) (cast (indir out (+ (* 2 (- k 1)) 1)) int))
	    ((qa int) (cast (indir out (* 2 k)) int))
	    ((qb int) (cast (indir out (+ (* 2 k) 1)) int)))
	(if (or (< qa pa) (and (= qa pa) (< qb pb)))
	    (set ok 0)))
      (set k (+ k 1)))
    ;; the same multiset: every output pair cancels its input pair
    (set k 0)
    (while (< k NELEMS)
      (let (((ia int) (pair_index (cast (indir out (* 2 k)) int)
				  (cast (indir out (+ (* 2 k) 1)) int))))
	(set (indir hist ia) (- (indir hist ia) 1)))
      (set k (+ k 1)))
    (set k 0)
    (while (< k 10000)
      (if (!= 0 (indir hist k))
	  (set ok 0))
      (set k (+ k 1)))
    (free data)
    (free out)
    (free hist)
    (return ok)))

(define-function main int ((argc int) (argv char * *))
  (let* (((nthreads int) (if (> argc 1) (atoi (indir argv 1)) 1))
	 ((nbytes int) (* NBYTES_PER_THREAD nthreads))
	 ((mem char *) (malloc (cast nbytes long)))
	 ((init nile_Process_t *) (nile_startup mem nbytes nthreads))
	 ((failed int) 0))
    (if (= 0 (cast init long))
	(return 1))
    (if (= 0 (run_sort init))
	(set failed 1))
    (if (= failed 0)
	(printf "sort ok\n")
	(printf "sort FAILED\n"))
    (free (nile_shutdown init))
    (return failed)))
