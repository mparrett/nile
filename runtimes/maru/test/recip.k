;; Many pipelines of hand-written reciprocal kernels, each fed the same floats
;; and ending in a Capture. Each pipeline's sum must match the direct sum
;; (R-recip). Reciprocal does two reciprocal iterations per element, so each
;; stage gives back its input and every pipeline's sum is the direct sum.
;; argv[1] is the worker count, one by default. Prints "recip ok" when every
;; pipeline agrees; check nile_recip compares the line.

(define (printf (int char * ...) *) (extern printf))
(define (malloc (void * long) *) (extern malloc))
(define (free (void void *) *) (extern free))
(define (atoi (int char *) *) (extern atoi))

(define (NPIPELINES int) 1000)
(define (NREALS int) 1000)
(define (NSTAGES int) 7)
(define (NBYTES_PER_THREAD int) 1000000)

;; The kernel the Maru generator would emit for a Reciprocal with no variables.
(define-function test_Reciprocal_body int
  ((p nile_Process_t *) (in float *) (i int) (m int) (out float *) (j int) (n int))
  (let (((status int) 0)
	((r float) (cast 0.0 float)))
    (while (= status 0)
      (while (< i m)
	(set r (indir in i))
	(set i (+ i 1))
	(set r (/ (cast 1.0 float) r))
	(set r (/ (cast 1.0 float) r))
	(if (= j n)
	    (nile_Process_advance_output p (addressof out) (addressof j) (addressof n)))
	(set (indir out j) r)
	(set j (+ j 1)))
      (set status (nile_Process_advance_input p (addressof in) (addressof i) (addressof m))))
    (return (nile_Process_return p i j status))))

(define-function test_Reciprocal (nile_Process_t *) ((parent nile_Process_t *))
  (return (nile_Process parent 1 1 0 0 test_Reciprocal_body 0)))

;; Funnel into NSTAGES reciprocals into a Capture of NREALS floats; returns the funnel.
(define-function build_pipeline (nile_Process_t *)
  ((init nile_Process_t *) (out float *) (count int *))
  (let (((p nile_Process_t *) (nile_Capture init out count NREALS))
	(i 0))
    (while (< i NSTAGES)
      (set p (nile_Process_pipe (test_Reciprocal init) p))
      (set i (+ i 1)))
    (return (nile_Process_pipe (nile_Funnel init) p))))

;; The same LCG as the other checks: Park-Miller, so the floats are fixed.
(define-function fill_data void ((data float *))
  (let (((seed long) 17837643)
	(i 0))
    (while (< i NREALS)
      (set seed (% (* seed (cast 48271 long)) (cast 2147483647 long)))
      (set (indir data i) (/ (* (cast (cast seed double) float) (cast 1000.0 float))
			     (cast 2147483647.0 float)))
      (set i (+ i 1)))))

(define-function sum_of double ((xs float *) (n int))
  (let (((s double) 0.0)
	(i 0))
    (while (< i n)
      (set s (+ s (cast (indir xs i) double)))
      (set i (+ i 1)))
    (return s)))

(define-function close_enough int ((a double) (b double))
  (let (((d double) (- a b)))
    (if (< d 0.0)
	(set d (- 0.0 d)))
    (return (< d (* 0.001 (if (< b 0.0) (- 0.0 b) b))))))

(define-function main int ((argc int) (argv char * *))
  (let* (((nthreads int) (if (> argc 1) (atoi (indir argv 1)) 1))
	 ((nbytes int) (* NBYTES_PER_THREAD nthreads))
	 ((mem char *) (malloc (cast nbytes long)))
	 ((init nile_Process_t *) (nile_startup mem nbytes nthreads))
	 ((data float *) (malloc (cast (* NREALS 4) long)))
	 ((out float *) (malloc (cast (* NREALS 4) long)))
	 ((count int) 0)
	 ((expected double) 0.0)
	 ((failed int) 0)
	 (k 0))
    (if (= 0 (cast init long))
	(return 1))
    (fill_data data)
    (set expected (sum_of data NREALS))
    (while (and (= failed 0) (< k NPIPELINES))
      (set count 0)
      (nile_Funnel_pour (build_pipeline init out (addressof count)) data NREALS 1)
      (nile_sync init)
      (if (nile_error init)
	  (set failed 1))
      (if (and (= failed 0)
	       (or (!= count NREALS)
		   (= 0 (close_enough expected (sum_of out NREALS)))))
	  (set failed 1))
      (if (= failed 1)
	  (printf "recip FAILED pipeline %d\n" k))
      (set k (+ k 1)))
    (if (= failed 0)
	(printf "recip ok\n"))
    (free (nile_shutdown init))
    (free data)
    (free out)
    (return failed)))
